{
  "name": "number-game-dashboard",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/seeded-random",
    "packages/game-server-api",
    "packages/number-game",
    "packages/block-game",
    "packages/disk-game",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "start": "node --env-file-if-exists=.env apps/server/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
